# =========================
# Proctored Assessment Platform
# Environment Variables
# =========================

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assessment_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assessment_platform
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Worker
WORKER_CONCURRENCY=4

# Plagiarism
PLAGIARISM_KGRAM_SIZE=25
PLAGIARISM_WINDOW_SIZE=4
PLAGIARISM_THRESHOLD=0.70

# Proctoring
PROCTORING_FLAG_THRESHOLD=3

# Docker Sandbox
SANDBOX_CPU_LIMIT=0.5
SANDBOX_DEFAULT_MEMORY_MB=256
SANDBOX_PIDS_LIMIT=64

# Rate Limiting
SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
SUBMISSION_RATE_LIMIT_MAX=10

# Client
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
